{
  "name": "TAB: Take A Break",
  "description": "Reduce your screentime",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {
      "16": "images/tab_icon2.png",
      "32": "images/tab_icon2.png",
      "64": "images/tab_icon2.png",
      "128": "images/tab_icon2.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
  "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.youtube.com"
},
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_popup": "tab_main.html",
    "default_icon": {
      "16": "images/tab_icon2.png",
      "32": "images/tab_icon2.png",
      "64": "images/tab_icon2.png",
      "128": "images/tab_icon2.png"
    }
  },
  "content_scripts": [{
  "matches": ["<all_urls>"],
  "js": ["scripts/content.js"]
}]
  
}