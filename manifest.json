{
  "name": "TAB: Take A Break",
  "description": "Reduce your screentime",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {
      "16": "images/tab_icon2.png",
      "32": "images/tab_icon2.png",
      "64": "images/tab_icon2.png",
      "128": "images/tab_icon2.png"
  },
  "permissions": ["storage","alarms", "tabs", "scripting"],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_popup": "tab_main.html",
    "default_icon": {
      "16": "images/tab_icon2.png",
      "32": "images/tab_icon2.png",
      "64": "images/tab_icon2.png",
      "128": "images/tab_icon2.png"
    }
  },
  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
  
}